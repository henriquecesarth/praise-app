# Servidor
PORT=3000
NODE_ENV=development
JWT_SECRET=praise-app-jwt-secret-key-change-in-production
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK (Produção e Desenvolvimento)
FIREBASE_PROJECT_ID=praise-app-7a362
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@praise-app-7a362.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://praise-app-7a362.firebaseio.com
FIREBASE_WEB_API_KEY=AIzaSy...

# Ministério Padrão e Administração
DEFAULT_MINISTRY_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
PLATFORM_ADMIN_SECRET=sua-chave-secreta-de-administrador-da-plataforma

# Faturamento e Timezone Comercial
# Timestamps de auditoria são gravados em UTC ISO-8601.
# A data comercial de faturamento (dueDate, nextDueDate) segue estritamente o timezone configurado abaixo.
BILLING_TIMEZONE=America/Sao_Paulo

# Gateway de Pagamentos Asaas (Sandbox / Production)
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=$aact_...
ASAAS_WEBHOOK_TOKEN=seu-token-forte-exclusivo-para-webhooks
