     // ------------------------------------------------------------------- bridge
 
+    /** TEMPORARY bench probe: phases of one seek, in ms since the command. */
+    private object SeekProbe {
+        @Volatile var t0 = Long.MAX_VALUE
+        val oldExit = AtomicLong()
+        val starts = AtomicInteger()
+        val sixthStart = AtomicLong()
+        val opens = AtomicInteger()
+        val sixthOpen = AtomicLong()
+        val firstWrite = AtomicLong()
+
+        private fun now() = SystemClock.elapsedRealtime() - t0
+
+        fun reset(at: Long) {
+            t0 = Long.MAX_VALUE
+            oldExit.set(0); starts.set(0); sixthStart.set(0); opens.set(0); sixthOpen.set(0); firstWrite.set(0)
+            t0 = at
+        }
+
+        fun write() {
+            if (sixthOpen.get() > 0) firstWrite.compareAndSet(0, now())
+        }
+
+        fun line() = "released=${oldExit.get()} started=${sixthStart.get()} open=${sixthOpen.get()} write=${firstWrite.get()}"
+    }
+
+    private class Timed(private val inner: AndroidMp3PcmDecoder = AndroidMp3PcmDecoder()) : Mp3WindowDecoder {
+        override fun decodeFrom(
+            file: File,
+            byteOffset: Long,
+            input: Mp3InputCheck,
+            onInfo: (Mp3StreamInfo) -> Unit,
+            sink: PcmSink,
+            cancelled: () -> Boolean,
+        ) {
+            val begun = SystemClock.elapsedRealtime()
+            val fresh = begun >= SeekProbe.t0
+            if (fresh && SeekProbe.starts.incrementAndGet() == 6) SeekProbe.sixthStart.set(begun - SeekProbe.t0)
+            try {
+                inner.decodeFrom(file, byteOffset, input, { info ->
+                    if (fresh && SeekProbe.opens.incrementAndGet() == 6) {
+                        SeekProbe.sixthOpen.set(SystemClock.elapsedRealtime() - SeekProbe.t0)
+                    }
+                    onInfo(info)
+                }, sink, cancelled)
+            } finally {
+                val t0 = SeekProbe.t0
+                val end = SystemClock.elapsedRealtime()
+                if (begun < t0 && end >= t0) SeekProbe.oldExit.accumulateAndGet(end - t0) { a, b -> maxOf(a, b) }
+            }
+        }
+    }
+
